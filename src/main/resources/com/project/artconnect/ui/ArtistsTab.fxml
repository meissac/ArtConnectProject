<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtistController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Search bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search artists..."
                   HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="disciplineFilter"
                  promptText="Filter by Discipline"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <!-- Action buttons -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add Artist"
                onAction="#handleAdd"
                style="-fx-background-color: #27ae60;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Edit Artist"
                onAction="#handleEdit"
                style="-fx-background-color: #2980b9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Delete Artist"
                onAction="#handleDelete"
                style="-fx-background-color: #e74c3c;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="artistTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn"
                         text="Name" prefWidth="180"/>
            <TableColumn fx:id="cityColumn"
                         text="City" prefWidth="120"/>
            <TableColumn fx:id="emailColumn"
                         text="Email" prefWidth="180"/>
            <TableColumn fx:id="yearColumn"
                         text="Birth Year" prefWidth="90"/>
            <TableColumn fx:id="disciplinesColumn"
                         text="Disciplines" prefWidth="160"/>
            <TableColumn fx:id="artworkCountColumn"
                         text="Artworks" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>