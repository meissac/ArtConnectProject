<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets bottom="10.0" left="10.0"
                right="10.0" top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add Workshop"
                onAction="#handleAdd"
                style="-fx-background-color: #27ae60;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Edit Workshop"
                onAction="#handleEdit"
                style="-fx-background-color: #2980b9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Delete Workshop"
                onAction="#handleDelete"
                style="-fx-background-color: #e74c3c;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn"
                         text="Title" prefWidth="180"/>
            <TableColumn fx:id="instructorColumn"
                         text="Instructor" prefWidth="140"/>
            <TableColumn fx:id="dateColumn"
                         text="Date" prefWidth="140"/>
            <TableColumn fx:id="priceColumn"
                         text="Price" prefWidth="80"/>
            <TableColumn fx:id="levelColumn"
                         text="Level" prefWidth="100"/>
            <TableColumn fx:id="participantsColumn"
                         text="Participants" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>