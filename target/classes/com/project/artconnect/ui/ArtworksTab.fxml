<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0"
                right="10.0" top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add Artwork"
                onAction="#handleAdd"
                style="-fx-background-color: #27ae60;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Edit Artwork"
                onAction="#handleEdit"
                style="-fx-background-color: #2980b9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
        <Button text="Delete Artwork"
                onAction="#handleDelete"
                style="-fx-background-color: #e74c3c;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

        <!-- NEW: View Reviews button -->
        <Button text="View Reviews"
                onAction="#handleViewReviews"
                style="-fx-background-color: #8e44ad;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn"
                         text="Title" prefWidth="180"/>
            <TableColumn fx:id="artistColumn"
                         text="Artist" prefWidth="140"/>
            <TableColumn fx:id="typeColumn"
                         text="Type" prefWidth="100"/>
            <TableColumn fx:id="priceColumn"
                         text="Price" prefWidth="90"/>
            <TableColumn fx:id="statusColumn"
                         text="Status" prefWidth="120"/>
            <TableColumn fx:id="avgRatingColumn"
                         text="Avg Rating" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>